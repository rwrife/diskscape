<Window x:Class="DiskScape.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="diskscape"
        Height="440"
        Width="760"
        MinWidth="640"
        MinHeight="360"
        Background="#111827"
        Foreground="#E5E7EB">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="diskscape"
               FontSize="30"
               FontWeight="Bold" />

    <Border Grid.Row="2"
            Background="#1F2937"
            BorderBrush="#374151"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
      <StackPanel>
        <TextBlock TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,0,0,8"
                   Text="DiskScape.App packaging baseline is ready. Core scanning, cleanup, and report primitives live in DiskScape.Core and are now wired for CI and Windows release artifacts." />
        <TextBlock x:Name="CoreVersionText"
                   FontFamily="Consolas"
                   FontSize="13" />
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="3"
               Margin="0,12,0,0"
               Opacity="0.85"
               Text="Tip: use releases for portable zip / MSIX artifacts; this shell is intentionally minimal for milestone M6." />
  </Grid>
</Window>
